# Homebrew formula for unipdf-debugger.
# Rendered from scripts/homebrew/unipdf-debugger.rb.tmpl by the release workflow
# and committed to github.com/unidoc/homebrew-tap.
# DO NOT hand-edit the rendered formula on the tap repo -- next release overwrites it.
class UnipdfDebugger < Formula
  desc "Open-source, cross-platform PDF structure inspector"
  homepage "https://github.com/unidoc/unipdf-debugger"
  version "@@VERSION@@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "@@DARWIN_ARM64_URL@@"
      sha256 "@@DARWIN_ARM64_SHA256@@"
    end
    on_intel do
      url "@@DARWIN_AMD64_URL@@"
      sha256 "@@DARWIN_AMD64_SHA256@@"
    end
  end

  on_linux do
    on_intel do
      url "@@LINUX_AMD64_URL@@"
      sha256 "@@LINUX_AMD64_SHA256@@"
    end
  end

  # Single class-level install method. Defining `def install` inside
  # `on_macos`/`on_linux` blocks is a Ruby class-body trap: both `def`
  # statements run at load time and the second overwrites the first
  # regardless of platform. Branch on OS.mac? / OS.linux? instead.
  def install
    if OS.mac?
      # Rename the .app to match the user-facing formula name so
      # `open -a unipdf-debugger` resolves alongside the shim on $PATH.
      prefix.install "unidoc-pdf-debugger.app" => "unipdf-debugger.app"
      bin.write_exec_script prefix/"unipdf-debugger.app/Contents/MacOS/unidoc-pdf-debugger" => "unipdf-debugger"
    else
      bin.install "unidoc-pdf-debugger" => "unipdf-debugger"
    end
  end

  test do
    system bin/"unipdf-debugger", "--version"
  end
end
